# Copy to config/llm.yaml to change provider. config/llm.yaml is git-ignored.
# provider: mock | openai_compatible | anthropic
provider: mock
model: mock-grounded-v1
temperature: 0.0
max_tokens: 1500

# openai_compatible examples:
#   Ollama (free, local): base_url: http://localhost:11434/v1, model: llama3.1, api_key_env: ""
#   OpenAI:               base_url: https://api.openai.com/v1, api_key_env: OPENAI_API_KEY
# anthropic example:      model: claude-sonnet-5-5, api_key_env: ANTHROPIC_API_KEY
base_url: null
api_key_env: null
