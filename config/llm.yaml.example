# Copy to config/llm.yaml to change provider. config/llm.yaml is git-ignored.
# Never put an API key in this file: name the environment variable that holds it instead.
#
# provider: mock | openai_compatible | anthropic
provider: mock
model: mock-grounded-v1
temperature: 0.0         # used by openai_compatible only
max_tokens: 16000        # upper limit for the reply; too low cuts the JSON off mid-way
timeout_seconds: 120     # give up on a slow provider instead of hanging the page
json_mode: true          # openai_compatible: request a JSON object (turn off if a server rejects it)
base_url: null
api_key_env: null

# --- Examples (pip install -e ".[llm]" first) ------------------------------------------
# Ollama (free, local, no key):
#   provider: openai_compatible
#   base_url: http://localhost:11434/v1
#   model: llama3.1
#
# OpenAI:
#   provider: openai_compatible
#   base_url: https://api.openai.com/v1
#   model: <model name>
#   api_key_env: OPENAI_API_KEY
#
# Anthropic (Claude):
#   provider: anthropic
#   model: claude-opus-5-5
#   api_key_env: ANTHROPIC_API_KEY   # or leave null to use the SDK's own credential lookup
